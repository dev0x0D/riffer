pkgname=riffer
pkgver=0.1.0
pkgrel=1
pkgdesc='Slow down music to practice along, without changing the pitch'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-wayland' 'xdg-desktop-portal' 'ffmpeg' 'soundtouch')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/riffer "$pkgdir/usr/bin/riffer"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/riffer.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/riffer.svg"
  install -Dm644 "$startdir/riffer.desktop" "$pkgdir/usr/share/applications/riffer.desktop"
}
